# =====================================================================
# Supabase Edge Functions — local dev
# =====================================================================
# For local development with `supabase start` / `supabase functions
# serve`, the edge functions read Deno.env. Set the values in this
# file (rename to .env; supabase-cli loads it automatically) or
# configure them in the Supabase dashboard under
# Edge Functions → Secrets for production deploys.
#
# The Next.js side (.env.example at the repo root) has the
# matching values for the Vercel deploy. Keep both in sync.
# =====================================================================

# Canonical Supabase URL. Same as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Anonymous key. Same as NEXT_PUBLIC_SUPABASE_ANON_KEY. The
# edge functions use it for the user-scoped client; the
# service-role key below is what actually does the work.
SUPABASE_ANON_KEY=

# Service-role key. Bypasses RLS — use only inside edge
# functions. Same as SUPABASE_SERVICE_ROLE_KEY on the
# Vercel side.
SUPABASE_SERVICE_ROLE_KEY=

# Shared with the Vercel cron jobs. Must match CRON_SECRET in
# the Vercel env. The functions return 401 on mismatch.
CRON_SECRET=

# Default cutoff hour for process-cutoffs. The per-cohort
# config (set in /admin/schedule) overrides this. Default 3.
# DEFAULT_CUTOFF_HOUR=3

# VAPID subject. Same as VAPID_SUBJECT on the Vercel side.
# VAPID_SUBJECT=mailto:ops@example.com

# VAPID private key. Same as VAPID_PRIVATE_KEY on the Vercel
# side. The send-push function reads this when the web-push
# library lands; until then it's a no-op.
# VAPID_PRIVATE_KEY=
