# =====================================================================
# Vercel (Next.js) — set these in the Vercel dashboard or
# `vercel env`. NEXT_PUBLIC_* are baked into the client bundle at
# build time; the rest are read at server runtime. Without these
# the app will not start.
# =====================================================================

# Public (baked into the client bundle; must be set at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# VAPID public key MUST be NEXT_PUBLIC_ so the client-side
# PushSubscription component can read it. The private key is
# server-only (read by the send-push edge function). Generate
# with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only (read at runtime; never reach the browser)
SUPABASE_SERVICE_ROLE_KEY=
# VAPID subject is the contact URL embedded in push requests
# (per RFC 8030). Use a mailto: or https: URL you control.
VAPID_SUBJECT=mailto:ops@example.com
# Shared secret between the Vercel cron and the Supabase edge
# functions. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional (recommended in production)
# HMAC secret for OTP gate tokens. If unset, the code falls back
# to SUPABASE_SERVICE_ROLE_KEY (which works for dev but means a
# service-role rotation invalidates every outstanding OTP token).
# Generate with: openssl rand -hex 32
# OTP_TOKEN_SECRET=

# =====================================================================
# Supabase Edge Functions — set these in the Supabase dashboard
# (Edge Functions → Secrets) or `supabase/.env` for local
# supabase-cli deploys. The edge functions live in a different
# global scope from the Next.js process so the env names need to
# be set there too.
# =====================================================================

# Same value as NEXT_PUBLIC_SUPABASE_URL. The edge functions use
# the canonical Supabase env name (SUPABASE_URL) while Next uses
# NEXT_PUBLIC_ for the browser bundle. Set both to the same URL.
SUPABASE_URL=
# Same as the server-only SUPABASE_SERVICE_ROLE_KEY above.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same as CRON_SECRET above.
CRON_SECRET=
# Default cutoff hour for the process-cutoffs function when a
# cohort has no row in cohort_schedule_config. The per-cohort
# config (set in /admin/schedule) overrides this. Default 3.
# DEFAULT_CUTOFF_HOUR=3

# =====================================================================
# VAPID private key (Phase 9 reads it in send-push via the web-push
# library; the actual call is currently a TODO — until the library
# lands, leave it blank and the function will no-op on delivery).
# Set the same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY's pair.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# =====================================================================

# =====================================================================
# Structured logging (Phase 9 OTLP shipper)
# =====================================================================
# LOG_SINK=console (default) — prints JSON to stdout.
# LOG_SINK=otlp — ships to a real OTLP-shaped collector.
# LOG_SINK=otlp+console — dual-pipe (recommended for Vercel:
# keeps the Vercel log explorer line + ships to Datadog/Honeycomb).
#
#   LOG_SINK=otlp+console
#   LOG_OTLP_ENDPOINT=https://your-collector.example.com/v1/logs
#   LOG_OTLP_HEADERS={"Authorization":"Bearer xxx"}
#   LOG_OTLP_BATCH_MS=250          # batch before flush (0 = none)
#   LOG_OTLP_SERVICE=discipline-os # service.name attribute
#   LOG_OTLP_VERSION=1.0.0         # service.version attribute
