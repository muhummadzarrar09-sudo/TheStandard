# Public (baked into the client bundle; must be set at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# VAPID public key MUST be NEXT_PUBLIC_ so the client-side
# PushSubscription component can read it. The private key is server-
# only and is read by the send-push edge function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only (never reach the browser; can be set at runtime)
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
CRON_SECRET=

# Optional
# HMAC secret used to sign OTP gate tokens. If unset, the service-role
# key is used as a fallback. Set this in production so rotating the
# service-role key doesn't invalidate outstanding OTP tokens.
# OTP_TOKEN_SECRET=
#
# Structured logging. LOG_SINK=console (default) prints JSON to stdout.
# Set LOG_SINK=otlp to ship to a real OTLP-shaped collector. Use
# LOG_SINK=otlp+console to dual-pipe (recommended for Vercel: keeps
# the Vercel log explorer line + ships to Datadog/Honeycomb/etc).
#
#   LOG_SINK=otlp
#   LOG_OTLP_ENDPOINT=https://your-collector.example.com/v1/logs
#   LOG_OTLP_HEADERS={"Authorization":"Bearer xxx"}
#   LOG_OTLP_BATCH_MS=250          # optional; batch before flush
#   LOG_OTLP_SERVICE=discipline-os # optional; service.name attribute
#   LOG_OTLP_VERSION=1.0.0         # optional; service.version attribute
