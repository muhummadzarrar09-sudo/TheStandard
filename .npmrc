# The project pins typescript 7.0.2 but @typescript-eslint/parser 8.x
# only advertises peer support up to TS 6.x. The actual packages work
# fine together (we have 518/518 tests passing), so opt into the
# lenient peer resolution. This makes `npm ci` succeed on Vercel
# without the build worker having to pass --legacy-peer-deps explicitly.
legacy-peer-deps=true
